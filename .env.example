# Telegram Bot API token from @BotFather (required)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs with admin privileges (optional)
ADMIN_IDS=123456789

# SQLAlchemy async database URL
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Railway PostgreSQL (example — use the DATABASE_URL Railway injects):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/railway

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Default model for g4f AI agents (no API key required)
AI_MODEL=gpt-4o-mini

# Recommended for reliable generation on Railway (pick one)
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
